Options -Indexes
DirectoryIndex index.php

RewriteEngine On
RewriteBase /nepal-tourism/

# Block framework/sensitive dirs from the web
RewriteRule ^(app|config|database|storage)/ - [F,L]

# Block dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]